# CodeGraph Environment Variables

# FalkorDB Configuration
# Cloud URL (takes priority if set) - format: hostname:port
FALKORDB_URL=
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# Local/Docker fallback configuration
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# API Configuration
API_PORT=3001

# Web Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# OpenAI Configuration (for natural language queries)
OPENAI_API_KEY=

# Embedding provider: local | openrouter | voyage
# voyage uses voyage-code-3 (1024-dim, code-optimized)
CODEGRAPH_EMBEDDING_PROVIDER=voyage
CODEGRAPH_EMBEDDING_DIM=1024
VOYAGE_API_KEY=

# Reranker provider: voyage | jina (voyage recommended — better cross-encoder scoring for "graph operations" class queries)
# voyage reranker: set CODEGRAPH_RERANK_PROVIDER=voyage, CODEGRAPH_RERANK_MODEL=rerank-2, VOYAGE_API_KEY=<key>
# jina reranker: set CODEGRAPH_RERANK_PROVIDER=jina, JINA_API_KEY=<key>
CODEGRAPH_RERANK_PROVIDER=voyage
CODEGRAPH_RERANK_MODEL=rerank-2
JINA_API_KEY=

# LLM Provider: cerebras | openrouter | glm | ollama
LLM_PROVIDER=cerebras
CEREBRAS_API_KEY=

# Project to analyze (for Docker volumes)
PROJECT_PATH=./sample
