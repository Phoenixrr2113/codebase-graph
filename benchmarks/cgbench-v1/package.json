{
  "name": "@codegraph/cgbench-v1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:competitors": "vitest run --config vitest.competitors.config.ts",
    "test:watch": "vitest",
    "bench": "tsx src/cli.ts",
    "bench:clone-corpora": "tsx scripts/clone-corpora.ts",
    "bench:render-docs": "tsx scripts/render-docs.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codegraph/core": "workspace:*",
    "@codegraph/graph": "workspace:*",
    "@codegraph/types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
