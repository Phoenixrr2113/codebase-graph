{
  "mcpServers": {
    "codegraph": {
      "command": "npx",
      "args": ["tsx", "/path/to/user/Desktop/codebase-graph/packages/mcp-server/src/index.ts"],
      "env": {
        "CODEGRAPH_DRIVER": "falkordblite",
        "CODEGRAPH_DB_PATH": ".codegraph/falkordb",
        "VOYAGE_API_KEY": "YOUR_VOYAGE_API_KEY",
        "JINA_API_KEY": "YOUR_JINA_API_KEY"
      }
    }
  }
}
