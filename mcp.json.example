// Public npm package
{
  "mcpServers": {
    "codegraph": {
      "command": "npx",
      "args": ["-y", "@agntk/codegraph-mcp"]
    }
  }
}

// Source checkout after building packages/mcp-server/dist/index.js
{
  "mcpServers": {
    "codegraph": {
      "command": "node",
      "args": ["/absolute/path/to/codebase-graph/packages/mcp-server/dist/index.js"]
    }
  }
}

// No provider key is required. Local embeddings are selected automatically.
// To opt into a cloud provider, add VOYAGE_API_KEY or OPENROUTER_API_KEY to the selected server's env object through your MCP client's protected secret configuration.
