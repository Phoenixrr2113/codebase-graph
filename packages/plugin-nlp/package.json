{
  "name": "@codegraph/plugin-nlp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Natural language processing for entity/relationship extraction",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@codegraph/graph": "workspace:*",
    "@codegraph/logger": "workspace:*",
    "@codegraph/types": "workspace:*",
    "@huggingface/transformers": "^4.2.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.66",
    "cheerio": "^1.2.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pdf-parse": "^1.1.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
