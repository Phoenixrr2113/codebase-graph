{
  "$schema": "Security rules for OWASP Top 10 vulnerability scanning",
  "version": "1.0.0",

  "taint_sources": {
    "user_input": [
      "request.body",
      "request.query",
      "request.params",
      "req.body",
      "req.query",
      "req.params",
      "ctx.request.body",
      "event.body"
    ],
    "environment": [
      "process.env"
    ],
    "file_read": [
      "fs.readFileSync",
      "fs.readFile",
      "readFile"
    ],
    "api_response": [
      "response.data",
      "res.data",
      "axios."
    ]
  },

  "sql_injection": {
    "severity": "critical",
    "description": "Potential SQL injection: user input in SQL query",
    "fix": "Use parameterized queries or an ORM to prevent SQL injection",
    "methods": [
      "query",
      "execute",
      "raw",
      "$queryRaw",
      "$executeRaw",
      "rawQuery"
    ],
    "dangerous_patterns": [
      "`.*\\$\\{.*\\}.*`",
      "\\+.*['\"]"
    ]
  },

  "xss": {
    "severity": "high",
    "description": "Potential XSS vulnerability",
    "fix": "Sanitize user input before rendering in the DOM",
    "properties": [
      "innerHTML",
      "outerHTML"
    ],
    "methods": [
      "document.write",
      "document.writeln"
    ],
    "jsx_properties": [
      "dangerouslySetInnerHTML"
    ]
  },

  "command_injection": {
    "severity": "critical",
    "description": "Potential command injection: user input in shell command",
    "fix": "Use execFile with an argument array instead of exec with string concatenation",
    "methods": [
      "exec",
      "execSync",
      "spawn",
      "spawnSync",
      "execFile",
      "execFileSync"
    ],
    "modules": [
      "child_process"
    ]
  },

  "path_traversal": {
    "severity": "high",
    "description": "Potential path traversal: user input in file path",
    "fix": "Validate and sanitize file paths; use path.resolve and check against a base directory",
    "methods": [
      "readFile",
      "readFileSync",
      "writeFile",
      "writeFileSync",
      "createReadStream",
      "createWriteStream",
      "open",
      "openSync",
      "access",
      "accessSync"
    ]
  },

  "hardcoded_secrets": {
    "severity": "high",
    "description": "Hardcoded secret or credential detected",
    "fix": "Use environment variables or a secrets manager for credentials",
    "patterns": [
      "['\"](api[_-]?key|apikey)['\"]\\s*[:=]\\s*['\"][^'\"]{16,}['\"]",
      "['\"](secret|api[_-]?secret)['\"]\\s*[:=]\\s*['\"][^'\"]{16,}['\"]",
      "['\"]AKIA[0-9A-Z]{16}['\"]",
      "['\"]sk_(?:live|test)_[a-zA-Z0-9_]{24,}['\"]",
      "['\"]-----BEGIN (?:RSA |DSA |EC )?PRIVATE KEY-----",
      "(?:password|passwd|pwd)\\s*[:=]\\s*['\"][^'\"]{4,}['\"]",
      "['\"]eyJ[a-zA-Z0-9_-]*\\.eyJ[a-zA-Z0-9_-]*\\.[a-zA-Z0-9_-]*['\"]"
    ],
    "pattern_flags": ["i", "i", "", "", "", "i", ""]
  },

  "eval_usage": {
    "severity": "medium",
    "description": "Dynamic code evaluation detected",
    "fix": "Avoid eval() and similar dynamic code execution; use safer alternatives",
    "functions": [
      "eval",
      "Function",
      "setTimeout",
      "setInterval"
    ]
  },

  "sanitizers": [
    "escape",
    "escapeHtml",
    "sanitize",
    "sanitizeHtml",
    "encodeURIComponent",
    "encodeURI",
    "htmlEscape",
    "sqlEscape",
    "parameterize",
    "DOMPurify.sanitize",
    "validator.escape"
  ]
}
