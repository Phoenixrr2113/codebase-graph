{
  "name": "@codegraph/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && cp src/analysis/rules/*.json dist/analysis/rules/",
    "dev": "tsc --watch",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@codegraph/graph": "workspace:*",
    "@codegraph/logger": "workspace:*",
    "@codegraph/plugin-nlp": "workspace:*",
    "@codegraph/plugin-csharp": "workspace:*",
    "@codegraph/plugin-go": "workspace:*",
    "@codegraph/plugin-java": "workspace:*",
    "@codegraph/plugin-rust": "workspace:*",
    "@codegraph/plugin-php": "workspace:*",
    "@codegraph/plugin-markdown": "workspace:*",
    "@codegraph/plugin-python": "workspace:*",
    "@codegraph/plugin-typescript": "workspace:*",
    "@codegraph/types": "workspace:*",
    "ai": "^6.0.0",
    "chokidar": "5.0.0",
    "fast-glob": "^3.3.3",
    "glob": "^10.3.10",
    "zod": "^3.23.8",
    "simple-git": "^3.30.0",
    "tree-sitter": "^0.21.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
