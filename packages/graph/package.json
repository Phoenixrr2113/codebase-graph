{
  "name": "@codegraph/graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts && vitest run --config vitest.lite.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@codegraph/logger": "workspace:*",
    "@codegraph/types": "workspace:*",
    "falkordb": "^6.6.2"
  },
  "devDependencies": {
    "falkordblite": "^0.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@falkordblite/darwin-arm64": "8.2.3-falkordb.4.16.3",
    "@falkordblite/linux-x64": "8.2.3-falkordb.4.16.3"
  }
}
