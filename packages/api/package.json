{
  "name": "@codegraph/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@codegraph/core": "workspace:*",
    "@codegraph/graph": "workspace:*",
    "@codegraph/logger": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.12.23"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.22.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
