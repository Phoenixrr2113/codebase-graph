{
  "name": "@codegraph/plugin-typescript",
  "version": "0.1.0",
  "description": "TypeScript/JavaScript language plugin for CodeGraph",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root . --config ../../vitest.package.config.ts"
  },
  "dependencies": {
    "@codegraph/logger": "workspace:*",
    "@codegraph/plugin-common": "workspace:*",
    "@codegraph/types": "workspace:*",
    "tree-sitter": "^0.22.4",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "tree-sitter": "^0.22.4"
  }
}
