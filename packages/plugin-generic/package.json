{
  "name": "@codegraph/plugin-generic",
  "version": "0.1.0",
  "description": "Generic tree-sitter plugin factory for CodeGraph (FEAT.8)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codegraph/plugin-common": "workspace:*",
    "@codegraph/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
